# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Use the full Neon (or any PostgreSQL) connection URL
# For Neon: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (web + mobile/expo if needed)
# Use * to allow all origins in development (NOT for production)
CORS_ORIGIN=http://localhost:3000

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Stripe Payments ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ─── Google OAuth (optional — disables Google login if not set) ───────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── RabbitMQ (optional — falls back to in-process event bus if not set) ──────
RABBITMQ_URL=amqp://localhost

# ─── OpenTelemetry Tracing (optional) ─────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
